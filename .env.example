# Contact form (EmailJS). Copy this file to `.env` and fill in your own IDs.
# These keys are publishable — they ship in the browser bundle by design.
# Restrict usage with allowed domains + rate limits in the EmailJS dashboard.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
